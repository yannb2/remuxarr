@page "/copy-subtitles"
@using Muxarr.Core.Config
@using Muxarr.Core.SubtitleCopy
@using Muxarr.Core.Utilities
@using Muxarr.Web.Services.SubtitleCopy
@implements IDisposable

@* Fork: take subtitle tracks from other files (BD remuxes, loose .srt/.ass/.sup in /downloads or
   /mnt/pc) and add them to a library series, episode by episode, through the normal queue. *@

<PageTitle>@TitleHelper.GetTitle("Copy subtitles")</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 mux-page-header gap-2">
        <h2 class="mb-0 me-auto"><i class="bi bi-badge-cc me-2"></i>Copy subtitles</h2>
    </div>

    <p class="text-body-secondary small">
        Adds subtitle tracks from other files to a movie, or to the episodes of a series, in the library. Episodes
        are matched by their names (S01E02, 1x02 or an anime's absolute number), a movie by its title and year;
        you can give any file another donor by hand.
        The timing check finds a shift (a different logo at the start) or a PAL speed-up. When the other release is
        cut differently (an ad break, a longer scene), Auto-sync retimes a text subtitle part by part with alass,
        against the file's own subtitles or its sound. Each file then goes through the queue as a normal conversion: the profile names, orders and flags the new tracks with the others,
        and the usual checks run before the original is replaced.
    </p>

    @* 1. Series or movie *@
    <div class="border rounded p-3 mb-3">
        <h5 class="mb-2"><span class="badge text-bg-secondary me-2">1</span>Series or movie in the library</h5>
        @if (_series == null)
        {
            <span class="spinner-border spinner-border-sm"></span>
        }
        else if (_seriesFolder == null)
        {
            <div class="d-flex gap-2 mb-2 flex-wrap">
                <input class="form-control form-control-sm flex-grow-1 w-auto" placeholder="Search a series or movie" @bind="_seriesFilter" @bind:event="oninput"/>
                <div class="btn-group btn-group-sm">
                    @foreach (var (kind, label) in KindFilters)
                    {
                        <button class="btn @(_kindFilter == kind ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => _kindFilter = kind">
                            @label <span class="opacity-75">@CountOf(kind)</span>
                        </button>
                    }
                </div>
            </div>
            <div class="list-group list-group-flush border rounded mux-copy-list">
                @{ var shown = FilteredSeries().ToList(); }
                @foreach (var folder in shown.Take(MaxListed))
                {
                    <button class="list-group-item list-group-item-action py-1 small text-break d-flex align-items-center gap-2" @onclick="() => PickSeries(folder)">
                        <i class="bi @(folder.IsSeries ? "bi-tv" : "bi-film") text-muted"></i>
                        <span>@folder.Path</span>
                        <span class="text-muted ms-auto text-nowrap">@(folder.IsSeries ? $"{folder.Count} episode{(folder.Count == 1 ? "" : "s")}" : $"{folder.Count} file{(folder.Count == 1 ? "" : "s")}")</span>
                    </button>
                }
                @if (shown.Count == 0)
                {
                    <span class="list-group-item small text-muted">No folder matches.</span>
                }
                else if (shown.Count > MaxListed)
                {
                    <span class="list-group-item small text-muted">@(shown.Count - MaxListed) more: type to narrow the list.</span>
                }
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <code class="text-break">@_seriesFolder</code>
                <span class="text-muted small">@_rows.Count @(_pickedIsSeries ? "episode" : "file")@(_rows.Count == 1 ? "" : "s")</span>
                <button class="btn btn-sm btn-link" @onclick="ClearSeries" disabled="@_busy">Change</button>
            </div>
        }
    </div>

    @* 2. Donor folder *@
    <div class="border rounded p-3 mb-3">
        <h5 class="mb-2"><span class="badge text-bg-secondary me-2">2</span>Donor folder</h5>
        @if (_roots.Count == 0)
        {
            @if (_missingRoots.Count > 0)
            {
                <div class="small text-warning-emphasis">
                    <i class="bi bi-exclamation-triangle me-1"></i>@string.Join(" and ", _missingRoots)
                    @(_missingRoots.Count == 1 ? "is" : "are") set as donor folder@(_missingRoots.Count == 1 ? "" : "s") but not found in the container.
                    Mount @(_missingRoots.Count == 1 ? "it" : "them") in the compose file (read-only is enough) and recreate the container.
                </div>
            }
            else
            {
                <span class="text-muted small">No donor folders are set. Add them in <a href="settings/processing">Settings &gt; Processing</a>.</span>
            }
        }
        else if (_donorFolder == null)
        {
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var root in _roots)
                {
                    <button class="btn btn-sm @(_browse == root ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => Browse(root)">@root</button>
                }
            </div>
            @if (_missingRoots.Count > 0)
            {
                <div class="small text-muted mb-2">
                    <i class="bi bi-info-circle me-1"></i>Not found in the container (not mounted): @string.Join(", ", _missingRoots)
                </div>
            }
            @if (_browse != null)
            {
                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                    @if (_roots.All(r => r != _browse))
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="BrowseUp"><i class="bi bi-arrow-up"></i></button>
                    }
                    <code class="text-break">@_browse</code>
                    <button class="btn btn-sm btn-primary ms-auto" @onclick="UseFolder" disabled="@(_busy || _seriesFolder == null)"
                            title="@(_seriesFolder == null ? "Pick the series first" : "")">
                        <i class="bi bi-check2 me-1"></i>Use this folder
                    </button>
                </div>
                @if (_browseError != null)
                {
                    <div class="text-danger small">@_browseError</div>
                }
                <div class="list-group list-group-flush border rounded mux-copy-list">
                    @foreach (var sub in _browseFolders)
                    {
                        <button class="list-group-item list-group-item-action py-1 small text-break" @onclick="() => Browse(sub)">
                            <i class="bi bi-folder me-1"></i>@Path.GetFileName(sub)
                        </button>
                    }
                    @if (_browseFolders.Count == 0)
                    {
                        <span class="list-group-item small text-muted">No folders here.</span>
                    }
                </div>
                <div class="text-muted small mt-1">@_browseDonorCount donor file@(_browseDonorCount == 1 ? "" : "s") directly in this folder (sub-folders are read too).</div>
            }
        }
        else
        {
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <code class="text-break">@_donorFolder</code>
                <span class="text-muted small">@_donors.Count file@(_donors.Count == 1 ? "" : "s")</span>
                <button class="btn btn-sm btn-link" @onclick="ClearDonors" disabled="@_busy">Change</button>
            </div>
        }
        @if (_status != null)
        {
            <div class="small mt-2"><span class="spinner-border spinner-border-sm me-1"></span>@_status</div>
        }
    </div>

    @if (_seriesFolder != null && _donorFolder != null && !_busyLoading)
    {
        @* 3. Tracks *@
        <div class="border rounded p-3 mb-3">
            <h5 class="mb-2"><span class="badge text-bg-secondary me-2">3</span>Tracks to copy</h5>
            @if (_kinds.Count == 0)
            {
                <span class="text-muted small">The donor files have no subtitle tracks.</span>
            }
            else
            {
                <p class="text-muted small mb-2">Ticked for every file. Languages the library copy has no full subtitles in are ticked to start with.</p>
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                    @foreach (var (kind, count) in _kinds)
                    {
                        var loose = _looseKinds.Contains(kind);
                        var final = _renamed.GetValueOrDefault(kind, kind);
                        <tr>
                            <td style="width: 1%;">
                                <input type="checkbox" class="form-check-input" checked="@_wanted.Contains(kind)"
                                       @onchange="e => ToggleKind(kind, e.Value is true)"/>
                            </td>
                            <td>
                                @kind.Label
                                <span class="text-muted small ms-1">in @count donor file@(count == 1 ? "" : "s")</span>
                                @if (loose)
                                {
                                    <span class="badge text-bg-light border ms-1" title="Language and flags come from the file names">from file names</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (loose)
                                {
                                    <div class="d-inline-flex align-items-center gap-2 flex-wrap justify-content-end">
                                        <select class="form-select form-select-sm w-auto" value="@final.LanguageCode"
                                                @onchange="e => Rename(kind, final with { LanguageCode = e.Value?.ToString() ?? kind.LanguageCode })">
                                            @if (IsoLanguage.Find(final.LanguageCode) == IsoLanguage.Unknown)
                                            {
                                                <option value="@final.LanguageCode">@final.LanguageCode</option>
                                            }
                                            @foreach (var language in Languages)
                                            {
                                                <option value="@language.Code">@language.Name</option>
                                            }
                                        </select>
                                        <label class="small text-nowrap"><input type="checkbox" class="form-check-input me-1" checked="@final.Forced"
                                                                              @onchange="e => Rename(kind, final with { Forced = e.Value is true })"/>Forced</label>
                                        <label class="small text-nowrap"><input type="checkbox" class="form-check-input me-1" checked="@final.Sdh"
                                                                              @onchange="e => Rename(kind, final with { Sdh = e.Value is true })"/>SDH</label>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        @* 4. Episodes *@
        <div class="border rounded p-3 mb-3">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                <h5 class="mb-0 me-auto"><span class="badge text-bg-secondary me-2">4</span>@(_pickedIsSeries ? "Episodes" : "Files")</h5>
                <button class="btn btn-sm btn-outline-primary" @onclick="CheckAll" disabled="@(_busy || _rows.All(r => r.Assignments.Count == 0))">
                    <i class="bi bi-stopwatch me-1"></i>Check timing
                </button>
                <div class="input-group input-group-sm w-auto">
                    <button class="btn btn-outline-primary" @onclick="SyncAll" disabled="@(_busy || SyncWork().Count == 0)"
                            title="Retimes the ticked text tracks with alass, part by part (handles cuts and ad breaks)">
                        <i class="bi bi-magic me-1"></i>Auto-sync
                    </button>
                    <select class="form-select form-select-sm mux-copy-reference" value="@_syncReference" disabled="@_busy"
                            title="What Auto-sync lines the donor up with"
                            @onchange="e => _syncReference = Enum.TryParse<SyncReference>(e.Value?.ToString(), out var r) ? r : SyncReference.Subtitles">
                        <option value="@SyncReference.Subtitles">with the file's subtitles</option>
                        <option value="@SyncReference.Audio">with the file's sound</option>
                    </select>
                </div>
                @if (_busy && _checking)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="StopCheck">Stop</button>
                }
                <button class="btn btn-sm btn-primary" @onclick="Queue" disabled="@(_busy || Queueable().Count == 0)">
                    <i class="bi bi-play-fill me-1"></i>Queue @Queueable().Count @(_pickedIsSeries ? "episode" : "file")@(Queueable().Count == 1 ? "" : "s")
                </button>
            </div>
            <p class="text-muted small mb-2">
                The last column is the dry run: the tracks each file gets, named as its profile names them.
                Nothing is written until you queue.
                @if (Unchecked() > 0)
                {
                    <span class="text-warning-emphasis">@Unchecked() donor@(Unchecked() == 1 ? " has" : "s have") no timing check yet.</span>
                }
            </p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 mux-copy-table">
                    <thead>
                    <tr>
                        <th style="width: 1%;"></th>
                        <th>@(_pickedIsSeries ? "Episode" : "Movie")</th>
                        <th>Donor and timing</th>
                        <th>Tracks added</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr class="@(row.Include ? "" : "text-muted")">
                            <td class="align-top">
                                <input type="checkbox" class="form-check-input" checked="@row.Include"
                                       @onchange="e => { row.Include = e.Value is true; }"/>
                            </td>
                            <td class="align-top">
                                <div class="fw-semibold">@row.Label</div>
                                <div class="small text-break">@Path.GetFileName(row.Target.Path)</div>
                                <div class="small text-muted">@ChapterInfo.FormatTime(row.Target.Snapshot.DurationMs)</div>
                            </td>
                            <td class="align-top">
                                @foreach (var assignment in row.Assignments)
                                {
                                    <div class="mb-2">
                                        <div class="small text-break">
                                            <i class="bi @(assignment.Donor.IsLoose ? "bi-file-text" : "bi-film") me-1 text-muted"></i>@assignment.Donor.Name
                                            @if (!assignment.Donor.IsLoose)
                                            {
                                                <span class="text-muted ms-1">@ChapterInfo.FormatTime(assignment.Donor.DurationMs)</span>
                                            }
                                            <button class="btn btn-sm btn-link text-danger p-0 ms-1" title="Take this donor off" @onclick="() => Unassign(row, assignment)" disabled="@_busy">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        @{ var shifted = assignment.Synced.Count == 0 || HasUnsyncedTracks(row, assignment); }
                                        <div class="d-flex align-items-center gap-2 flex-wrap small">
                                            @if (shifted)
                                            {
                                            <TimingBadge Assignment="assignment"/>
                                            <label class="text-nowrap">Shift
                                                <input class="form-control form-control-sm d-inline-block mux-copy-offset" value="@Seconds(assignment.OffsetMs)"
                                                       @onchange="e => SetOffset(row, assignment, e.Value?.ToString())" disabled="@_busy"/> s
                                            </label>
                                            <select class="form-select form-select-sm w-auto" disabled="@_busy"
                                                    value="@SubtitleTiming.Stretches.ToList().FindIndex(s => s.Numerator == assignment.Stretch.Numerator && s.Denominator == assignment.Stretch.Denominator)"
                                                    @onchange="e => SetStretch(row, assignment, e.Value?.ToString())">
                                                @for (var i = 0; i < SubtitleTiming.Stretches.Count; i++)
                                                {
                                                    <option value="@i">@(i == 0 ? "No stretch" : SubtitleTiming.Stretches[i].Label)</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => CheckOne(row, assignment)" disabled="@_busy">Check</button>
                                            }
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => SyncOne(row, assignment)"
                                                    disabled="@(_busy || SyncTracks(row, assignment).Count == 0)" title="@SyncTitle(row, assignment)">
                                                <i class="bi bi-magic me-1"></i>Auto-sync
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => Preview(row, assignment)" disabled="@(_busy || PreviewTrack(row, assignment) == null)"
                                                    title="A minute of captions, side by side">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </div>
                                        @if (assignment.TimingNote != null && shifted)
                                        {
                                            <div class="small text-muted">@assignment.TimingNote</div>
                                        }
                                        @if (assignment.Syncing)
                                        {
                                            <div class="small"><span class="badge text-bg-light border"><span class="spinner-border spinner-border-sm me-1"></span>auto-syncing</span></div>
                                        }
                                        @if (assignment.Synced.Count > 0)
                                        {
                                            <div class="small mt-1 mux-copy-synced">
                                                @foreach (var (index, synced) in assignment.Synced.OrderBy(x => x.Key))
                                                {
                                                    <div>
                                                        <SyncBadge Synced="synced"/>
                                                        <span class="text-muted">@(assignment.Donor.IsLoose ? "" : $"Track {index}: ")@SubtitleSync.Describe(synced.Report) @synced.Note</span>
                                                    </div>
                                                }
                                                <div class="text-muted">
                                                    @(assignment.Synced.Count == 1 ? (assignment.Donor.IsLoose ? "It goes" : "This track goes") : "These tracks go") in retimed@(HasUnsyncedTracks(row, assignment) ? "; the shift and stretch above are for the donor's other tracks." : ".")
                                                    <button class="btn btn-sm btn-link p-0 align-baseline" @onclick="() => Unsync(row, assignment)" disabled="@_busy">Undo</button>
                                                </div>
                                            </div>
                                        }
                                        @if (assignment.SyncError != null)
                                        {
                                            <div class="small text-danger">Auto-sync: @assignment.SyncError</div>
                                        }
                                    </div>
                                }
                                <select @key="row.Assignments.Count" class="form-select form-select-sm mux-copy-assign" value="" disabled="@_busy"
                                        @onchange="e => Assign(row, e.Value?.ToString())">
                                    <option value="">@(row.Assignments.Count == 0 ? "No match: pick a donor..." : "Add another donor...")</option>
                                    @foreach (var donor in _donors.OrderBy(d => DonorOrder(row, d)))
                                    {
                                        @if (row.Assignments.All(a => a.Donor != donor))
                                        {
                                            <option value="@donor.Path">@(donor.Key != null ? $"{donor.Key.Label} - " : "")@Relative(donor.Path)</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td class="align-top small">
                                @if (row.Problem != null)
                                {
                                    <span class="text-muted">@row.Problem</span>
                                }
                                else if (row.Plan?.Donors is { } added)
                                {
                                    @foreach (var donor in added)
                                    {
                                        <div>
                                            <i class="bi bi-plus-circle text-success me-1"></i>@(string.IsNullOrEmpty(donor.Output!.Name) ? "(no name)" : donor.Output.Name)
                                            <span class="text-muted">@donor.Output.LanguageCode</span>
                                            @if (donor.Output.IsDefault == true)
                                            {
                                                <span class="badge text-bg-light border">default</span>
                                            }
                                            @if (donor.Output.IsForced == true)
                                            {
                                                <span class="badge text-bg-light border">forced</span>
                                            }
                                            @if (donor.Output.IsHearingImpaired == true)
                                            {
                                                <span class="badge text-bg-light border">SDH</span>
                                            }
                                        </div>
                                    }
                                    @foreach (var left in row.Picked.Where(p => p.Donor.Output == null))
                                    {
                                        <div class="text-muted" title="The profile's language or duplicate rules leave it out">
                                            <i class="bi bi-dash-circle me-1"></i>@KindLabel(left) left out by the profile
                                        </div>
                                    }
                                    @if (row.Plan.Tracks.Count < row.Target.Snapshot.Tracks.Count)
                                    {
                                        <div class="text-warning-emphasis" title="The profile would also do this without the new tracks">
                                            <i class="bi bi-info-circle me-1"></i>The profile also drops @(row.Target.Snapshot.Tracks.Count - row.Plan.Tracks.Count) of the file's own tracks.
                                        </div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Spare().Count > 0)
            {
                <details class="mt-3">
                    <summary class="small">@Spare().Count donor file@(Spare().Count == 1 ? " is" : "s are") not given to any file</summary>
                    <ul class="small mb-0">
                        @foreach (var donor in Spare())
                        {
                            <li class="text-break">@Relative(donor.Path)
                                @if (donor.Error != null)
                                {
                                    <span class="text-danger ms-1">@donor.Error</span>
                                }
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>

        @if (_preview != null || _previewStatus != null || _previewError != null)
        {
            <div class="border rounded p-3 mb-3" id="copy-preview">
                <div class="d-flex align-items-center mb-2">
                    <h5 class="mb-0 me-auto"><i class="bi bi-eye me-2"></i>Side by side @_previewTitle</h5>
                    <button class="btn btn-sm btn-link text-muted" @onclick="ClosePreview">Close</button>
                </div>
                @if (_previewStatus != null)
                {
                    <div class="small"><span class="spinner-border spinner-border-sm me-1"></span>@_previewStatus</div>
                }
                @if (_previewError != null)
                {
                    <div class="text-danger small">@_previewError</div>
                }
                @if (_preview != null)
                {
                    <p class="text-muted small mb-2">A minute from a third of the way in. Donor captions are shown at the time they will play
                        (after the stretch and shift); lined-up captions share a row.</p>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                            <tr>
                                <th style="width: 90px;">At</th>
                                <th>In the file</th>
                                <th>From the donor</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var line in _preview)
                            {
                                <tr>
                                    <td class="small text-nowrap">@ChapterInfo.FormatTime(line.AtMs)</td>
                                    <td><CaptionCell Caption="line.Mine"/></td>
                                    <td>
                                        <CaptionCell Caption="line.Theirs"/>
                                        @if (line.Mine != null && line.Theirs != null && line.Theirs.StartMs != line.Mine.StartMs)
                                        {
                                            <span class="small text-muted ms-1">@((line.Theirs.StartMs - line.Mine.StartMs) > 0 ? "+" : "")@(line.Theirs.StartMs - line.Mine.StartMs) ms</span>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (_preview.Count == 0)
                            {
                                <tr><td colspan="3" class="text-muted small">No captions in that minute.</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

<style>
    .mux-copy-list { max-height: 260px; overflow-y: auto; }
    .mux-copy-offset { width: 6.5rem; }
    .mux-copy-assign { max-width: 32rem; }
    .mux-copy-reference { max-width: 13rem; }
    .mux-copy-table td { min-width: 10rem; }
</style>

@code {
    [Inject] public required IDbContextFactory<AppDbContext> ContextFactory { get; set; }
    [Inject] public required MediaConverterService MediaConverter { get; set; }
    [Inject] public required IToastService ToastService { get; set; }
    [Inject] public required ILogger<Index> Logger { get; set; }

    private sealed record SeriesFolder(string Path, int Count, bool IsSeries);

    private const int MaxListed = 300;
    private static readonly (string Kind, string Label)[] KindFilters = [("all", "All"), ("series", "Series"), ("movies", "Movies")];
    private string _kindFilter = "all";
    private bool _pickedIsSeries = true;
    private List<string> _missingRoots = [];

    private List<SeriesFolder>? _series;
    private string _seriesFilter = "";
    private string? _seriesFolder;
    private List<CopyRow> _rows = [];
    private HashSet<string> _seriesLanguages = new(StringComparer.OrdinalIgnoreCase);

    private List<string> _roots = [];
    private string? _browse;
    private List<string> _browseFolders = [];
    private int _browseDonorCount;
    private string? _browseError;
    private string? _donorFolder;
    private List<DonorFile> _donors = [];

    private List<(TrackKind Kind, int Count)> _kinds = [];
    private HashSet<TrackKind> _looseKinds = [];
    private readonly HashSet<TrackKind> _wanted = [];
    private readonly Dictionary<TrackKind, TrackKind> _renamed = [];

    private bool _busy;
    private bool _busyLoading;
    private bool _checking;
    private string? _status;
    private CancellationTokenSource _cancel = new();
    private CancellationTokenSource? _checkCancel;

    private SyncReference _syncReference = SyncReference.Subtitles;

    private List<SubtitleCopyEngine.PreviewRow>? _preview;
    private string? _previewStatus;
    private string? _previewError;
    private string? _previewTitle;

    private static readonly List<(string Code, string Name)> Languages = IsoLanguage.Languages
        .Where(l => l.WriteCode != null)
        .Select(l => (l.WriteCode!, l.Name))
        .DistinctBy(l => l.Item1)
        .OrderBy(l => l.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        AutoSync.CleanUp();
        await using var context = await ContextFactory.CreateDbContextAsync();
        var configured = context.Configs.GetOrDefault<ProcessingConfig>().GetDonorFolders();
        _roots = configured.Where(Directory.Exists).ToList();
        _missingRoots = configured.Where(r => !Directory.Exists(r)).ToList();
        var paths = await context.MediaFiles.Select(f => f.Path).ToListAsync();
        // A folder with episode-numbered files is a series; any other folder holds a movie.
        _series = paths
            .Where(p => !PathFilter.IsExtra(p))
            .GroupBy(SeriesFolderOf)
            .Select(g => new SeriesFolder(g.Key, g.Count(), g.Any(IsEpisode)))
            .OrderBy(f => f.Path, StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (_roots.Count == 1)
        {
            Browse(_roots[0]);
        }
    }

    // A series folder holds season folders; an episode sits in one of them, or straight
    // in the series folder when Sonarr has season folders off.
    private static string SeriesFolderOf(string file)
    {
        var folder = Path.GetDirectoryName(file) ?? "/";
        var name = Path.GetFileName(folder);
        var seasonish = name.StartsWith("Season", StringComparison.OrdinalIgnoreCase)
                        || name.StartsWith("Saison", StringComparison.OrdinalIgnoreCase)
                        || name.Equals("Specials", StringComparison.OrdinalIgnoreCase)
                        || name.StartsWith("S0", StringComparison.OrdinalIgnoreCase) && name.Length <= 4;
        return seasonish ? Path.GetDirectoryName(folder) ?? folder : folder;
    }

    private static bool IsEpisode(string path) => EpisodeKey.Parse(path)?.HasSeasonEpisode == true;

    private bool OfKind(SeriesFolder folder, string kind) =>
        kind == "all" || (kind == "series") == folder.IsSeries;

    private int CountOf(string kind) => (_series ?? []).Count(f => OfKind(f, kind));

    private IEnumerable<SeriesFolder> FilteredSeries() =>
        (_series ?? []).Where(f => OfKind(f, _kindFilter)
                                  && (_seriesFilter.Length == 0 || f.Path.Contains(_seriesFilter, StringComparison.OrdinalIgnoreCase)));

    private async Task PickSeries(SeriesFolder picked)
    {
        var folder = picked.Path;
        _pickedIsSeries = picked.IsSeries;
        await using var context = await ContextFactory.CreateDbContextAsync();
        var prefix = folder.TrimEnd('/') + "/";
        var files = await context.MediaFiles.WithTracksAndProfile()
            .Where(f => f.Path.StartsWith(prefix))
            .AsNoTracking()
            .ToListAsync();
        _rows = files
            .Where(f => !PathFilter.IsExtra(f.Path) && SeriesFolderOf(f.Path) == folder)
            .Select(f => new CopyRow
            {
                Target = f,
                Key = picked.IsSeries ? EpisodeKey.Parse(f.Path) : null,
                IsMovie = !picked.IsSeries
            })
            .OrderBy(r => r.Key?.Season ?? int.MaxValue)
            .ThenBy(r => r.Key?.Episodes.FirstOrDefault() ?? r.Key?.Absolute ?? int.MaxValue)
            .ThenBy(r => r.Target.Path, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _seriesLanguages = _rows.SelectMany(r => r.Target.Snapshot.Tracks)
            .Where(t => t.Type == MediaTrackType.Subtitles && !t.IsForced)
            .Select(t => t.LanguageCode)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _seriesFolder = folder;
        if (_donorFolder != null)
        {
            SubtitleCopyEngine.Match(_rows, _donors);
            RefreshKinds(true);
        }
    }

    private void ClearSeries()
    {
        _seriesFolder = null;
        _rows = [];
        ClosePreview();
    }

    private void Browse(string folder)
    {
        if (!InsideRoots(folder))
        {
            return;
        }

        _browse = folder;
        _browseError = null;
        try
        {
            var options = new EnumerationOptions { IgnoreInaccessible = true };
            var folders = Directory.EnumerateDirectories(folder, "*", options).Where(d => !Path.GetFileName(d).StartsWith('.'));
            // In a donor root such as /mnt/pc, list only the disks that are plugged in (an unplugged disk's mount point is
            // an empty folder on the root's own mount). Clicking the root again lists them again.
            if (_roots.Contains(folder))
            {
                folders = Arrkit.Files.Mounts.WithDisk(folders);
            }

            _browseFolders = folders.Order(StringComparer.OrdinalIgnoreCase).ToList();
            _browseDonorCount = Directory.EnumerateFiles(folder, "*", options).Count(SubtitleFiles.IsDonor);
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            _browseFolders = [];
            _browseDonorCount = 0;
            _browseError = e.Message;
        }
    }

    private void BrowseUp()
    {
        if (_browse != null && Path.GetDirectoryName(_browse) is { } parent && InsideRoots(parent))
        {
            Browse(parent);
        }
    }

    private bool InsideRoots(string folder) =>
        _roots.Any(root => folder == root || folder.StartsWith(root.TrimEnd('/') + "/", StringComparison.Ordinal));

    private async Task UseFolder()
    {
        if (_browse == null || !InsideRoots(_browse))
        {
            return;
        }

        _busy = true;
        _busyLoading = true;
        var folder = _browse;
        try
        {
            _status = "Looking for donor files...";
            await InvokeAsync(StateHasChanged);
            var files = await Task.Run(() => SubtitleCopyEngine.FindDonorFiles(folder), _cancel.Token);
            var donors = new List<DonorFile>();
            for (var i = 0; i < files.Count; i++)
            {
                _status = $"Reading the tracks of {i + 1} of {files.Count}: {Path.GetFileName(files[i])}";
                await InvokeAsync(StateHasChanged);
                donors.Add(await SubtitleCopyEngine.ProbeAsync(files[i]));
                _cancel.Token.ThrowIfCancellationRequested();
            }

            _donors = donors;
            _donorFolder = folder;
            SubtitleCopyEngine.Match(_rows, _donors);
            RefreshKinds(true);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException)
        {
            ToastService.ShowError($"Could not read {folder}: {e.Message}");
        }
        finally
        {
            _busy = false;
            _busyLoading = false;
            _status = null;
        }
    }

    private void ClearDonors()
    {
        _donorFolder = null;
        _donors = [];
        _kinds = [];
        _wanted.Clear();
        _renamed.Clear();
        foreach (var row in _rows)
        {
            row.Assignments.Clear();
            row.Plan = null;
        }

        ClosePreview();
    }

    // The kinds of track the donors have, and how many donors have each.
    private void RefreshKinds(bool pickDefaults)
    {
        var seen = new Dictionary<TrackKind, HashSet<string>>();
        var loose = new HashSet<TrackKind>();
        foreach (var donor in _donors)
        {
            foreach (var track in donor.Subtitles)
            {
                var kind = SubtitleCopyEngine.KindOf(donor, track);
                if (!seen.TryGetValue(kind, out var files))
                {
                    seen[kind] = files = [];
                }

                files.Add(donor.Path);
                if (donor.IsLoose)
                {
                    loose.Add(kind);
                }
            }
        }

        _kinds = seen.Select(x => (x.Key, x.Value.Count))
            .OrderBy(x => IsoLanguage.Find(x.Key.LanguageCode).Name)
            .ThenBy(x => x.Key.Forced).ThenBy(x => x.Key.Sdh).ThenBy(x => x.Key.Commentary).ThenBy(x => x.Key.Pictures)
            .ToList();
        _looseKinds = loose;
        if (pickDefaults)
        {
            _wanted.Clear();
            foreach (var (kind, _) in _kinds.Where(k => !k.Kind.Commentary && !_seriesLanguages.Contains(k.Kind.LanguageCode)))
            {
                _wanted.Add(kind);
            }
        }

        RefreshPlans();
    }

    private void ToggleKind(TrackKind kind, bool on)
    {
        if (on)
        {
            _wanted.Add(kind);
        }
        else
        {
            _wanted.Remove(kind);
        }

        RefreshPlans();
    }

    private void Rename(TrackKind kind, TrackKind to)
    {
        if (to == kind)
        {
            _renamed.Remove(kind);
        }
        else
        {
            _renamed[kind] = to;
        }

        RefreshPlans();
    }

    private void RefreshPlans()
    {
        foreach (var row in _rows)
        {
            SubtitleCopyEngine.Plan(row, _wanted, _renamed);
        }
    }

    private void Assign(CopyRow row, string? path)
    {
        var donor = _donors.FirstOrDefault(d => d.Path == path);
        if (donor == null)
        {
            return;
        }

        row.Assignments.Add(new Assignment { Donor = donor });
        row.Include = true;
        SubtitleCopyEngine.Plan(row, _wanted, _renamed);
    }

    private void Unassign(CopyRow row, Assignment assignment)
    {
        row.Assignments.Remove(assignment);
        SubtitleCopyEngine.Plan(row, _wanted, _renamed);
    }

    // The donor dropdown lists the same episode first, then by name.
    private static string DonorOrder(CopyRow row, DonorFile donor) =>
        (row.Key != null && donor.Key != null && donor.Key.SameEpisode(row.Key) ? "0" : "1") + donor.Path;

    private string Relative(string path) =>
        _donorFolder != null && path.StartsWith(_donorFolder + "/", StringComparison.Ordinal) ? path[(_donorFolder.Length + 1)..] : path;

    private List<DonorFile> Spare() =>
        _donors.Where(d => _rows.All(r => r.Assignments.All(a => a.Donor != d))).ToList();

    private int Unchecked() =>
        _rows.Where(r => r.Include).SelectMany(r => r.Assignments).Count(a => a.Timing == null && !a.Manual && a.Synced.Count == 0);

    private List<CopyRow> Queueable() =>
        _rows.Where(r => r.Include && r.Plan?.Donors is { Count: > 0 }).ToList();

    private static string Seconds(long ms) => (ms / 1000.0).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private void SetOffset(CopyRow row, Assignment assignment, string? text)
    {
        if (double.TryParse((text ?? "").Replace(',', '.').Trim(), System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out var seconds))
        {
            assignment.OffsetMs = (long)Math.Round(seconds * 1000);
            assignment.Manual = true;
            SubtitleCopyEngine.Plan(row, _wanted, _renamed);
        }
    }

    private void SetStretch(CopyRow row, Assignment assignment, string? value)
    {
        if (int.TryParse(value, out var i) && i >= 0 && i < SubtitleTiming.Stretches.Count)
        {
            assignment.Stretch = SubtitleTiming.Stretches[i];
            assignment.Manual = true;
            SubtitleCopyEngine.Plan(row, _wanted, _renamed);
        }
    }

    private async Task CheckAll()
    {
        var work = _rows.Where(r => r.Include).SelectMany(r => r.Assignments.Select(a => (Row: r, Assignment: a))).ToList();
        await RunChecks(work);
    }

    private Task CheckOne(CopyRow row, Assignment assignment)
    {
        assignment.Manual = false;
        return RunChecks([(row, assignment)]);
    }

    private async Task RunChecks(List<(CopyRow Row, Assignment Assignment)> work)
    {
        _busy = true;
        _checking = true;
        _checkCancel = CancellationTokenSource.CreateLinkedTokenSource(_cancel.Token);
        try
        {
            for (var i = 0; i < work.Count; i++)
            {
                var (row, assignment) = work[i];
                if (assignment.Manual && work.Count > 1)
                {
                    continue;
                }

                _status = $"Checking the timing of {i + 1} of {work.Count}: {row.Label} from {assignment.Donor.Name}";
                assignment.Checking = true;
                await InvokeAsync(StateHasChanged);
                try
                {
                    await SubtitleCopyEngine.CheckTimingAsync(row.Target, assignment, _checkCancel.Token);
                }
                catch (InvalidOperationException e)
                {
                    assignment.Timing = null;
                    assignment.TimingNote = e.Message;
                    Logger.LogWarning("Copy subtitles: timing check of {Donor} failed: {Error}", assignment.Donor.Path, e.Message);
                }
                finally
                {
                    assignment.Checking = false;
                }

                SubtitleCopyEngine.Plan(row, _wanted, _renamed);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped: what was checked stays.
        }
        finally
        {
            _busy = false;
            _checking = false;
            _status = null;
            _checkCancel?.Dispose();
            _checkCancel = null;
        }

        if (!_cancel.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopCheck() => _checkCancel?.Cancel();

    // The donor's ticked tracks Auto-sync can retime: text ones (pictures only shift).
    private static List<TrackSnapshot> SyncTracks(CopyRow row, Assignment assignment) =>
        row.Picked.Where(p => p.From == assignment && AutoSync.CanSync(SubtitleCopyEngine.KindOf(assignment.Donor, p.Track)))
            .Select(p => p.Track).DistinctBy(t => t.Index).ToList();

    private static bool HasUnsyncedTracks(CopyRow row, Assignment assignment) =>
        row.Picked.Any(p => p.From == assignment && !assignment.Synced.ContainsKey(p.Track.Index));

    private static string SyncTitle(CopyRow row, Assignment assignment)
    {
        if (SyncTracks(row, assignment).Count > 0)
        {
            return "Retime the ticked text tracks with alass, part by part (handles cuts and ad breaks)";
        }

        return row.Picked.Any(p => p.From == assignment)
            ? "Picture subtitles can only be shifted: use Check and the Shift box"
            : "Tick a track of this donor first";
    }

    private List<(CopyRow Row, Assignment Assignment)> SyncWork() =>
        _rows.Where(r => r.Include)
            .SelectMany(r => r.Assignments.Where(a => SyncTracks(r, a).Count > 0).Select(a => (Row: r, Assignment: a)))
            .ToList();

    private Task SyncAll() => RunSyncs(SyncWork());

    private Task SyncOne(CopyRow row, Assignment assignment) => RunSyncs([(row, assignment)]);

    private async Task RunSyncs(List<(CopyRow Row, Assignment Assignment)> work)
    {
        _busy = true;
        _checking = true;
        _checkCancel = CancellationTokenSource.CreateLinkedTokenSource(_cancel.Token);
        try
        {
            for (var i = 0; i < work.Count; i++)
            {
                var (row, assignment) = work[i];
                assignment.Syncing = true;
                assignment.SyncError = null;
                var tracks = SyncTracks(row, assignment);
                try
                {
                    foreach (var track in tracks)
                    {
                        var where = $"{(work.Count > 1 ? $"{i + 1} of {work.Count}: " : "")}{row.Label}, track {track.Index} of {assignment.Donor.Name}";
                        _status = $"Auto-sync {where}";
                        await InvokeAsync(StateHasChanged);
                        var synced = await AutoSync.SyncAsync(row.Target, assignment, track, _syncReference,
                            message => { _status = $"Auto-sync {where}: {message}"; InvokeAsync(StateHasChanged); },
                            _checkCancel.Token);
                        // A copy it replaces stays on disk (it may already be queued); old copies are swept after 30 days.
                        assignment.Synced[track.Index] = synced;
                        Logger.LogInformation("Copy subtitles: auto-synced track {Track} of {Donor} for {Target}: {What}",
                            track.Index, assignment.Donor.Path, row.Target.Path, SubtitleSync.Describe(synced.Report));
                    }
                }
                catch (InvalidOperationException e)
                {
                    assignment.SyncError = e.Message;
                    Logger.LogWarning("Copy subtitles: auto-sync of {Donor} failed: {Error}", assignment.Donor.Path, e.Message);
                }
                finally
                {
                    assignment.Syncing = false;
                }

                SubtitleCopyEngine.Plan(row, _wanted, _renamed);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped: what was synced stays.
        }
        finally
        {
            foreach (var (_, assignment) in work)
            {
                assignment.Syncing = false;
            }

            _busy = false;
            _checking = false;
            _status = null;
            _checkCancel?.Dispose();
            _checkCancel = null;
        }

        if (!_cancel.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Unsync(CopyRow row, Assignment assignment)
    {
        // The copies stay on disk (one may already be queued) until the 30-day sweep.
        assignment.Synced.Clear();
        assignment.SyncError = null;
        SubtitleCopyEngine.Plan(row, _wanted, _renamed);
    }

    // The donor track the preview shows: the first picked one from that donor, else its first subtitle.
    private TrackSnapshot? PreviewTrack(CopyRow row, Assignment assignment) =>
        row.Picked.Where(p => p.From == assignment).Select(p => p.Track).FirstOrDefault()
        ?? assignment.Donor.Subtitles.FirstOrDefault();

    private async Task Preview(CopyRow row, Assignment assignment)
    {
        var track = PreviewTrack(row, assignment);
        if (track == null)
        {
            return;
        }

        _busy = true;
        _preview = null;
        _previewError = null;
        _previewTitle = $"{row.Label}: track {track.Index} of {assignment.Donor.Name}";
        _previewStatus = "Reading a minute of both files...";
        await InvokeAsync(StateHasChanged);
        var folder = Path.Combine(Path.GetTempPath(), "muxarr-copy-preview", Guid.NewGuid().ToString("N"));
        try
        {
            _preview = await SubtitleCopyEngine.PreviewAsync(row.Target, assignment, track, folder, _cancel.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception e) when (e is InvalidOperationException or IOException or InvalidDataException)
        {
            _previewError = e.Message;
        }
        finally
        {
            _busy = false;
            _previewStatus = null;
            try
            {
                if (Directory.Exists(folder))
                {
                    Directory.Delete(folder, true);
                }
            }
            catch (IOException)
            {
                // Temp files: left for the OS.
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ClosePreview()
    {
        _preview = null;
        _previewError = null;
        _previewStatus = null;
    }

    private static string KindLabel((DonorTrack Donor, TrackSnapshot Track, Assignment From) picked) =>
        $"Track {picked.Track.Index} ({(string.IsNullOrEmpty(picked.Track.LanguageName) ? picked.Donor.LanguageCode ?? picked.Track.LanguageCode : picked.Track.LanguageName)})";

    private async Task Queue()
    {
        RefreshPlans();
        var items = Queueable()
            .Select(r => (File: r.Target, Donors: r.Plan!.Donors!.Select(d => new DonorTrack
            {
                Path = d.Path,
                TrackId = d.TrackId,
                OffsetMs = d.OffsetMs,
                StretchNumerator = d.StretchNumerator,
                StretchDenominator = d.StretchDenominator,
                LanguageCode = d.LanguageCode,
                IsForced = d.IsForced,
                IsHearingImpaired = d.IsHearingImpaired,
                Name = d.Name,
                IsCommentary = d.IsCommentary,
                SyncedFromPath = d.SyncedFromPath,
                SyncedFromTrackId = d.SyncedFromTrackId,
                Output = d.Output,
                BeforeIndex = d.BeforeIndex
            }).ToList()))
            .ToList();
        if (items.Count == 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var results = await MediaConverter.AddDonorBatchToQueue(items);
            var queued = results.Values.Count(r => r == QueueResult.Queued);
            if (queued > 0)
            {
                ToastService.ShowSuccess($"Added {queued} episode{(queued == 1 ? "" : "s")} to the conversion queue.");
            }

            var skipped = results.Where(r => r.Value != QueueResult.Queued).ToList();
            if (skipped.Count > 0)
            {
                ToastService.ShowInfo($"{skipped.Count} skipped: " + string.Join(", ", skipped.GroupBy(s => s.Value).Select(g => $"{g.Count()} {Why(g.Key)}")) + ".");
            }

            foreach (var row in _rows.Where(r => results.GetValueOrDefault(r.Target.Id) == QueueResult.Queued))
            {
                row.Include = false;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Why(QueueResult result) => result switch
    {
        QueueResult.FileMissing => "file missing",
        QueueResult.NotInLibrary => "no longer in the library",
        QueueResult.AlreadyQueued => "already in the queue",
        QueueResult.Hardlinked => "hardlinked",
        _ => result.ToString()
    };

    public void Dispose()
    {
        _cancel.Cancel();
        _cancel.Dispose();
    }
}

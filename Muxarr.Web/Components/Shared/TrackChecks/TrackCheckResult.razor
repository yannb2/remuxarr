@using Muxarr.Web.Components.Shared.Modals
@* What the checks found for one track, on the row under it in the Tracks table, with buttons that set the
   track's flags right there. Also the "Commentary or AD?" hint, which needs no check to show. *@

@{ var state = Session.StateOf(Track.Index); }
@if (ShowUnsure(Session, Track))
{
    <div class="d-flex align-items-center flex-wrap gap-1 small">
        <span class="badge text-bg-warning"
              title="A stereo track after the multichannel one in the same language: a commentary or an audio description. The file does not say which; listen to it.">Commentary or AD?</span>
        <span class="text-muted me-1">The file does not say; listen to it, then set:</span>
        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                @onclick="() => OnFlags.InvokeAsync(new TrackFlagPreset(Commentary: true))">Commentary</button>
        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-1"
                @onclick="() => OnFlags.InvokeAsync(new TrackFlagPreset(VisualImpaired: true))">AD</button>
    </div>
}
@if (state.Busy && state.Status != null)
{
    <div class="small text-muted"><span class="spinner-border spinner-border-sm me-1"></span>@state.Status</div>
}
@if (state.Error != null)
{
    <div class="alert alert-danger py-1 px-2 mb-0 mt-1 small d-flex justify-content-between">
        <span>@state.Error</span>
        <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-2" @onclick="() => Session.Update(() => state.Error = null)">Close</button>
    </div>
}
@if (state.Audio != null)
{
    <div class="mt-1">
        <audio controls autoplay src="@state.Audio" style="width: 100%; max-width: 480px;"></audio>
        <div class="small text-muted">
            From @TrackCheckSession.Clock(state.AudioAt), stereo preview.
            <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-2 align-baseline" @onclick="() => Session.Update(() => state.Audio = null)">Close</button>
        </div>
    </div>
}
@if (state.Guess is { } guess)
{
    <div class="small mt-1">
        <div class="d-flex align-items-center flex-wrap gap-1">
            @if (guess.Sdh)
            {
                <span class="badge text-bg-warning">Looks like SDH</span>
            }
            @if (guess.Commentary)
            {
                <span class="badge text-bg-warning">Looks like commentary</span>
            }
            @if (!guess.Sdh && !guess.Commentary)
            {
                <span class="badge text-bg-success">Looks like plain subtitles</span>
            }
            <span class="text-muted">@guess.Reason</span>
            <button type="button" class="btn btn-sm btn-link text-muted p-0 ms-auto" @onclick="() => Session.Update(() => state.Guess = null)">Close</button>
        </div>
        @if (guess.French is { Region: not null } french)
        {
            <div class="text-muted">
                Reads like French from @(french.Region == "CA" ? "Québec" : "France") (@french.Evidence).
            </div>
        }
        @if (TrackCheckSession.FlagsDiffer(Track, guess))
        {
            <div class="text-muted d-flex align-items-center flex-wrap gap-2 mt-1">
                <span><i class="bi bi-info-circle me-1"></i>The flags above say otherwise.</span>
                <button type="button" class="btn btn-sm btn-outline-primary py-0"
                        title="Set this track's SDH and commentary flags as the check says"
                        @onclick="() => OnFlags.InvokeAsync(new TrackFlagPreset(HearingImpaired: guess.Sdh, Commentary: guess.Commentary))">
                    Use these flags
                </button>
            </div>
        }
    </div>
}
@if (state.HasPreview)
{
    <div class="mt-1">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small text-muted">@state.Shown of @state.Found captions found in the slices.</span>
            <button type="button" class="btn btn-sm btn-link text-muted p-0" @onclick="() => Session.Update(() => state.ClosePreview())">Close</button>
        </div>
        <div class="mux-sub-preview border rounded p-2" style="max-height: 420px; overflow-y: auto; background: #1b1b1b;">
            @if (state.Pictures != null)
            {
                @foreach (var (at, image) in state.Pictures)
                {
                    <div class="mb-2 text-center">
                        <div class="small text-secondary text-start">@TrackCheckSession.Clock(at)</div>
                        <img src="@image" alt="Caption at @TrackCheckSession.Clock(at)" style="max-width: 100%; max-height: 90px;"/>
                    </div>
                }
            }
            else
            {
                @foreach (var cue in state.Texts!)
                {
                    <div class="mb-2 text-light small d-flex">
                        <span class="text-secondary me-3 flex-shrink-0">@TrackCheckSession.Clock(cue.Start)</span>
                        <span style="white-space: pre-line;">@cue.Text</span>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public required TrackCheckSession Session { get; set; }

    /// <summary>The row as the Tracks table has it, so the hints follow the flags being edited.</summary>
    [Parameter, EditorRequired] public required TrackSnapshot Track { get; set; }

    /// <summary>Sets flags on this track in the Tracks table.</summary>
    [Parameter] public EventCallback<TrackFlagPreset> OnFlags { get; set; }

    /// <summary>The hint stays until the track is marked as one or the other.</summary>
    public static bool ShowUnsure(TrackCheckSession session, TrackSnapshot track) =>
        session.Unsure.Contains(track.Index) && !track.IsCommentary && !track.IsVisualImpaired;

    /// <summary>Whether the row under the track has anything to show.</summary>
    public static bool HasAnything(TrackCheckSession session, TrackSnapshot track) =>
        ShowUnsure(session, track) || session.StateOf(track.Index).HasResult;
}
